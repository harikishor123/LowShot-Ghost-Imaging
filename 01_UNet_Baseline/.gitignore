# PROPOSED .gitignore. Not active: copy to the repository root as .gitignore only after review.
# Matches the GitHub column of REPO_INVENTORY.csv (generated by make_repo_inventory.py).

# environments and caches
.venv/
.venv-linux/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# pending decision, kept locally until thesis submission
archive_review_required/

# raw data: public downloads (see REPRODUCIBILITY.md)
/train/
/valid/
/data/extension_medmnist/raw/

# derived data: regenerable, hashes recorded
data/extension_medmnist/processed/
data/v2/*
!data/v2/splits/
!data/v2/metadata/

# training pools and selection sets (62 GB; MD5s in the freeze manifests)
outputs/**/pool_train*.npy
outputs/**/selection_val.npz
outputs/phase_final_low_shot_to_10k_reference/*.npy
outputs/phase_final_low_shot_to_10k_reference/*.npz

# checkpoints: frozen best.pt files go to a GitHub Release / Zenodo record, not Git
*.pt
*.keras

# exploratory arrays
results/**/*.npz
outputs/phase1_single_image/**/*.npz
outputs/phase1b_dgi/**/*.npz
outputs/phase2a_dgi_dataset/**/*.npz
outputs/phase2b_unet/**/*.npz
outputs/phase3_strong_baselines/**/*.npz
outputs/phase4a_noisy_baselines/**/*.npz
outputs/phase*/**/*.npy

# over GitHub's 50 MB warning size
results/audit/contact_sheet.png

# release build output and inference demo output (added 2026-11-05)
/dist/
/demo_out/

