# --- Python ---
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.pytest_cache/

# --- Virtual environments ---
.venv/
.venv-linux/
venv/

# --- OS files ---
.DS_Store
Thumbs.db

