# ============================================================
# MTP Ghost Imaging — Root .gitignore
# ============================================================

# --- Python caches ---
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# --- OS files ---
.DS_Store
Thumbs.db

# --- Virtual environments ---
.venv/
.venv-linux/
.venv-replacement/

# --- Nested .git directories (sub-repos preserved locally) ---
01_UNet_Baseline/.git
02_DiffTransFuse/.git

